# 1. Supabase Project URL (From: Dashboard -> Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous Public Key (From: Dashboard -> Settings -> API -> Project API keys -> anon/public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. (Optional) Owner Email for administrative upload privileges
VITE_OWNER_EMAIL=owner@example.com
