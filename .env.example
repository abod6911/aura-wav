# ==============================================================================
# AuraWave — Offline-First Cross-Device Sync & Supabase Configuration
# ==============================================================================

# 1. Supabase Project URL (Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous Public Key (Dashboard -> Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Audio Cloud Upload Toggle (Default: false)
# Keep false so heavy audio files remain 100% on Hugging Face CDN and do NOT consume Supabase 1GB limit.
VITE_ENABLE_SUPABASE_AUDIO_UPLOAD=false

# 4. (Optional) Owner Email for administration
VITE_OWNER_EMAIL=owner@example.com
